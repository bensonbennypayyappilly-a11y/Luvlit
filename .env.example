# Copy this file to .env and fill in real values from your Supabase project
# (Project Settings -> API). Never commit the real .env file.

# Server-side (read via process.env, e.g. in server functions and build tooling)
SUPABASE_PROJECT_ID=your-project-ref
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx
# Bypasses RLS entirely — server-only, never expose this to the client or commit it.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxx

# Client-side (inlined into the browser bundle at build time by Vite — VITE_ prefix required)
VITE_SUPABASE_PROJECT_ID=your-project-ref
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx
